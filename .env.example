# OpenRouter key: used for Jev (decisions) and the demo agent's LLM
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Jev decision model. Pin a version in production so verdicts don't drift.
JEV_MODEL=typesafe/jev-1.13
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
JEV_TIMEOUT_S=2.0

# shadow = log only (start here), enforce = block/sanitize
JAF_MODE=shadow
# What to do if Jev is down and rules found nothing: open (allow) or closed (block)
JAF_FAIL_MODE=open
JAF_BLOCK_THRESHOLD=0.85
JAF_FLAG_THRESHOLD=0.5

# Egress firewall: comma-separated hosts the agent may call (subdomains included).
# Empty = no allowlist (other egress checks still apply).
JAF_EGRESS_ALLOWLIST=
# Comma-separated canary tokens planted in system prompts; any outbound copy is blocked.
JAF_CANARY_TOKENS=FLAG_BLDR_AMMAN_2026_SECRET_SYSTEM_CANARY_X99

# Demo agent model on OpenRouter
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Dummy C2 listener (demo only, binds to localhost)
C2_HOST=127.0.0.1
C2_PORT=8765
