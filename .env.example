# OpenRouter API Key for Llama 3.1 8B Agent
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model ID (Default: meta-llama/llama-3.1-8b-instruct)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Local C2 Listener Configuration
C2_HOST=127.0.0.1
C2_PORT=8765

# Optional: Path to local Laya INT8 ONNX model
LAYA_ONNX_PATH=../../Jev/Laya/laya.int8.onnx
